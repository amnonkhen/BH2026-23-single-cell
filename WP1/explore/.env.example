# Typesense (docker-compose defaults — change in production)
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=bh2026-typesense-admin-key
TYPESENSE_COLLECTION=experiments

# Paths
EXPERIMENTS_JSON=../fenix/experiments.json

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Browser InstantSearch talks to Typesense with a search-only key
# minted by the API (never ship the admin key to the browser).
TYPESENSE_SEARCH_KEY_DESCRIPTION=bh2026-explore-search-only
